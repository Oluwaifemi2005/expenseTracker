# Vaultex Backend Environment Configuration
PORT=5000

# MongoDB Atlas connection string template (replace placeholders with your real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Environment Mode (set to production on Render)
NODE_ENV=development

# Client Origin for CORS and Cookies
# On Render: set to your Vercel deployment URL (e.g. https://expense-tracker-coral-one-95.vercel.app)
# Multiple origins can be comma-separated: https://expense-tracker-coral-one-95.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

